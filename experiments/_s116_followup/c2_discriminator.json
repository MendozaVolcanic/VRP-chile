  "a62_refutation": {
    "nti_max_A80_hypothesis": "REFUTED. AUC 0.251 (inverse): confirmed cat-b sits LOWER (med -0.941) than artifact (-0.919). nti_max does NOT discriminate; the floor ~-0.9 is shared by both classes (altitude/cold-bg contamination, A68/A80 caveat confirmed).",
    "best_discriminator": "test1_k_observed (integrated Test1 MIR excess, K; Coppola 2015 Eq.1). Global AUC 0.859, NOT tautological with triggered_test1 (overlap: triggered=False up to 11.19K, triggered=True from 3.0K).",
    "clean_cut_test": {
      "global_cut_K": 3.99,
      "focal_catb_lost_pct": 13.6,
      "nevado_artifact_rejected_pct": 69.8,
