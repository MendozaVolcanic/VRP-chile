# VRP Chile — local environment template
#
# Copia este archivo a `.env` (gitignored) y rellena con tus valores.
# NO commitear `.env`.
#
# El loader minimal en `pipeline/fetch.py:_load_dotenv_if_present()` cargará
# `.env` automáticamente si está en el repo root, sin requerir python-dotenv.
# Variables ya definidas en el ambiente (CI, exports manuales) tienen prioridad
# sobre `.env` — el loader NO sobrescribe.
#
# Ver docs/LOCAL_NRT_SETUP.md para instrucciones completas.

# ----------------------------------------------------------------------
# NASA Earthdata credentials
# ----------------------------------------------------------------------
# Opción A (RECOMENDADA): EARTHDATA_TOKEN persistente.
# Generar en https://urs.earthdata.nasa.gov/profile → tab "Generate Token".
# Vida 60 días. Rotar cada 50 días.
EARTHDATA_TOKEN=your_token_here

# Opción B (legacy fallback): USERNAME + PASSWORD.
# earthaccess preferirá EARTHDATA_TOKEN si está seteado, pero estas pueden
# servir como fallback si el token expira.
EARTHDATA_USERNAME=your_username_here
EARTHDATA_PASSWORD=your_password_here
